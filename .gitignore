# Python caches, virtual environments, packaging and test output.
__pycache__/
*.py[cod]
.venv/
venv/
.tox/
.nox/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
*.egg-info/
.eggs/
.coverage
.coverage.*
htmlcov/

# Node dependencies, package-manager caches, framework and coverage output.
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.yarn/build-state.yml
.next/
.nuxt/
.svelte-kit/
.turbo/
.parcel-cache/
coverage/
*.tsbuildinfo

# Generated build/output directories (not source or fixtures).
**/dist/
**/out/
/build-output/
/generated-output/

# Local IDE state.
/.local/
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
*.suo
*.user

# OS junk, editor backups, logs and temporary files.
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~
*.log
logs/
tmp/
temp/
.cache/

# Environment and local credentials; commit sanitized examples/templates only.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!**/.env.*.example
!**/.env.*.sample
!**/.env.*.template
.envrc
*.local.properties
*.local.yml
*.local.yaml
*.local.json
/secrets/
**/.secrets/
.aws/
.ssh/
*.key
*.p12
*.pfx
*.jks
*.keystore
